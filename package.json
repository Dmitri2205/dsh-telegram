{
  "name": "@local/dsh-telegram",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: connect agent to Telegram bot",
  "type": "module",
  "main": "./lib/server/index.js",
  "types": "./lib/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "/home/dmitry/deepseek-harness/node_modules/.bin/tsx --test test/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
