{
  "name": "@local/dsh-telegram",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: connect agent to Telegram bot",
  "type": "module",
  "main": "./lib/src/server/index.js",
  "types": "./lib/src/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/server/index.d.ts",
      "default": "./lib/src/server/index.js"
